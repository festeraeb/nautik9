# Personal phone data pulled from the device: never commit or push.
phone_sync/
# Runtime databases (the vault, phone copies) and debug screenshots.
*.db
*.db-wal
*.db-shm
phone_screen.png
target/
serve.log
*.log

# Android build output (signing keys live in ~/.config/nautik9-android, never here)
android/build/
*.jks

# Lemonade Nexus: the SDK is copied in at build time; invites are single-use secrets
liblemonade_nexus_sdk.so
*invite*.json
