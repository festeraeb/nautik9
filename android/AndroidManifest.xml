<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.festeraeb.nautik9">

    <!-- The server and the on-device model run in this app; INTERNET also lets the
         provider chain reach a home Lemonade when the phone is on that network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Online/offline state for the page (which features need a connection right now). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Read the inbox for Work SMS drafts. Nothing is ever sent by the app: replies
         open in the phone's own composer and you press send. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Haptic pulse button. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- GPS button only: asked for the first time you press it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Foreground service so Android does not kill the app while the on-device model works. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Remote care: start again after a reboot or an app update when the switch is on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Remote care: install an update the home fleet pushed. Android still shows its own
         confirmation, and only accepts an APK signed with this app's key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Button debugging on demand: turn Wireless debugging on (only after the owner says Yes, or when the
         app's own button self-test fails) and off again after an idle time. Granted once over adb:
         adb shell pm grant com.festeraeb.nautik9 android.permission.WRITE_SECURE_SETTINGS
         Without the grant the app says it cannot, and does nothing. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Reading this phone's own Wireless debugging port (mDNS) so the fleet need not scan for it. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:label="NautiK9"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale|locale|layoutDirection"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local AI server and on-device model that answer the app's own page, and, with remote care on, the owner's home fleet over Tailscale" />
        </service>
        <!-- Exported for the system's protected broadcasts (no other app may send these actions). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Yes / Not now on the Wireless debugging prompt (reached only through this app's PendingIntents). -->
        <receiver
            android:name=".DebugAnswer"
            android:exported="false" />
        <!-- The installer's result for an update (reached only through this app's PendingIntent). -->
        <receiver
            android:name=".InstallResult"
            android:exported="false" />
    </application>

    <queries>
        <!-- Package visibility (Android 11+): lets the app tell whether Tailscale is installed. -->
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>
</manifest>
