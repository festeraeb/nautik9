<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.festeraeb.nautik9">

    <!-- The server and the on-device model run in this app; INTERNET also lets the
         provider chain reach a home Lemonade when the phone is on that network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read the inbox for Work SMS drafts. Nothing is ever sent by the app: replies
         open in the phone's own composer and you press send. -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <application
        android:label="NautiK9"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>
</manifest>
